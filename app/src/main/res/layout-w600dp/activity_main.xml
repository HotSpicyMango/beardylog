<?xml version="1.0" encoding="utf-8"?>
<!-- 폴드 펼침·태블릿용 메인 화면. 하단 알약 바 대신 왼쪽 내비게이션 레일을 두고, 홈은 두 칸으로 나눈다.
     홈 뷰 id는 layout/activity_main.xml과 같아야 HomeSection이 그대로 동작하므로 한쪽을 고치면 다른 쪽도 맞출 것 -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" tools:context=".MainActivity" tools:theme="@style/Theme.Beardylog" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/beardyBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <com.google.android.material.navigationrail.NavigationRailView android:id="@+id/bottomNavigation" tools:viewBindingType="com.google.android.material.navigation.NavigationBarView" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingStart="8dp" android:paddingEnd="8dp" android:background="@android:color/transparent" app:elevation="0dp" app:menuGravity="center" app:paddingTopSystemWindowInsets="false" app:paddingBottomSystemWindowInsets="false" app:itemBackground="@drawable/bg_bottom_nav_item" app:itemActiveIndicatorStyle="@style/BottomNavNoIndicator" app:itemIconSize="22dp" app:itemTextAppearanceActive="@style/BottomNavLabelActive" app:itemTextAppearanceInactive="@style/BottomNavLabel" app:menu="@menu/bottom_navigation" app:labelVisibilityMode="labeled" app:itemIconTint="@color/bottom_nav_tint" app:itemTextColor="@color/bottom_nav_tint" />
        <!-- 최대 폭은 MainActivity가 화면 종류(두 칸/한 칸)에 따라 matchConstraintMaxWidth로 정한다 -->
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <LinearLayout android:id="@+id/mainColumn" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
                <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="24dp" android:paddingEnd="24dp" android:paddingBottom="24dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="BEARDY LOG" android:textColor="?attr/beardyAccent" android:textSize="30sp" android:textStyle="bold" />
                            <TextView android:id="@+id/currentDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/beardyTextSecondary" android:textSize="14sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:baselineAligned="false" android:orientation="horizontal">
                            <!-- 왼쪽 칸: 프로필 -->
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:text="내 도마뱀 프로필" android:textColor="?attr/beardyTextPrimary" android:textSize="17sp" android:textStyle="bold" />
                                    <Spinner android:id="@+id/profileSortSpinner" android:layout_width="wrap_content" android:layout_height="wrap_content" android:entries="@array/profile_sort_types" android:spinnerMode="dropdown" />
                                </LinearLayout>
                                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:scrollbars="none">
                                    <GridLayout android:id="@+id/profileGrid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:columnCount="1" android:rowCount="2" />
                                </HorizontalScrollView>
                                <LinearLayout android:id="@+id/selectedProfileInfoRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:minHeight="44dp" android:orientation="horizontal">
                                    <TextView android:id="@+id/selectedProfileInfo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textColor="?attr/beardyTextSecondary" android:textSize="13sp" />
                                    <com.google.android.material.button.MaterialButton android:id="@+id/selectedProfileDetailButton" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="12dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="상세 보기" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
                                </LinearLayout>
                            </LinearLayout>
                            <!-- 오른쪽 칸: 이번 주와 할 일 -->
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="28dp" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textColor="?attr/beardyTextPrimary" android:textSize="19sp" android:textStyle="bold" />
                                <TextView android:id="@+id/weekRange" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="?attr/beardyTextSecondary" android:textSize="13sp" />
                                <LinearLayout android:id="@+id/weekDays" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="10dp" android:clipChildren="false" android:orientation="horizontal" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Reminder" android:textColor="?attr/beardyTextPrimary" android:textSize="17sp" android:textStyle="bold" />
                                <LinearLayout android:id="@+id/plannedCareList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
                            </LinearLayout>
                        </LinearLayout>
                        <!-- 무게 추이는 두 칸 아래 전체 폭: 그래프가 넓어지고, 분할 화면의 좁은 칸에서도 머리글이 꺾이지 않는다 -->
                        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardBackgroundColor="?attr/beardySurface" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="?attr/beardyAccentContainer" app:strokeWidth="1dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="무게 추이" android:textColor="?attr/beardyTextPrimary" android:textSize="17sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/currentWeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/beardyAccent" android:textSize="14sp" />
                                    <com.google.android.material.button.MaterialButton android:id="@+id/weightDetailButton" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="12dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:contentDescription="무게 기록 상세 보기" android:text="@string/weight_detail_button" android:textSize="13sp" android:textStyle="bold" />
                                </LinearLayout>
                                <TextView android:id="@+id/weightPeriodLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="최근 1개월" android:textColor="?attr/beardyTextSecondary" android:textSize="12sp" />
                                <FrameLayout android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="8dp">
                                    <LinearLayout android:id="@+id/homeWeightChartContent" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
                                        <com.hsm.beardylog.ui.WeightAxisLabelsView android:id="@+id/weightAxisLabels" android:layout_width="42dp" android:layout_height="match_parent" android:paddingTop="12dp" android:paddingBottom="12dp" />
                                        <HorizontalScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:fillViewport="true" android:scrollbars="horizontal">
                                            <com.hsm.beardylog.ui.WeightChartView android:id="@+id/weightChart" android:layout_width="wrap_content" android:layout_height="match_parent" android:padding="12dp" />
                                        </HorizontalScrollView>
                                    </LinearLayout>
                                    <TextView android:id="@+id/homeWeightChartEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="최근 1개월 기록 없음" android:textColor="?attr/beardyTextSecondary" android:textSize="13sp" android:visibility="gone" />
                                </FrameLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
